# Legacy fallback only: prefer the Telegram Upload admin settings page.
# This extension does not load .env files. Saved admin values (including blanks)
# override config.php, which overrides these environment variables.
TG_DISK_BASE_URL=https://your-tg-disk.example.com
TG_DISK_CHAT_ID=-1000000000000
# Set locally to the same private value as tg-disk's NUXT_API_KEY (minimum 32 characters).
TG_DISK_API_KEY=
